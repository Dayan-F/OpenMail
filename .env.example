# ── LLM (Groq) ────────────────────────────────────────────────
# Your Groq key for the self-host path. Also used as a fallback for the demo.
# Get one free at https://console.groq.com/keys
GROQ_API_KEY=

# Optional fallback key for /demo. Normally each visitor connects their own key in
# the app, so leave this empty — set it only if you want the demo to run on your key
# (usage then bills against you). Can equal GROQ_API_KEY.
DEMO_GROQ_API_KEY=

# (Ollama is configured in the /setup UI, not here — no env vars needed.)

# ── Google OAuth (self-host only — create your own OAuth app) ──
# See the README for the 5-step setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ── App ───────────────────────────────────────────────────────
# Encrypts the session cookie. Any 32+ char random string: openssl rand -hex 32
SESSION_SECRET=

# Local SQLite file for the self-host (real Gmail) path — applications, timeline
# events, and the cursor. The hosted demo never touches it, so a demo deploy can
# leave this unset. No external database service (Turso etc.) required.
DATABASE_URL=file:./openmail.db

# Set to 1 for a demo-only deploy: the landing page shows just "Try the demo" and
# hides the self-host / Gmail path. Leave unset for the full local experience.
DEMO_ONLY=

# Deployed host for server-action origin checks, no scheme — e.g. openmail.vercel.app
# Unset in local dev; on Vercel it's inferred from VERCEL_URL, so it's optional there.
APP_ORIGIN=

# Shared secret for the daily cron endpoint (sent as the x-cron-secret header).
CRON_SECRET=

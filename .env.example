# ── LLM (Groq) ────────────────────────────────────────────────
# Your Groq key for the self-host path. Also used as a fallback for the demo.
# Get one free at https://console.groq.com/keys
GROQ_API_KEY=

# Powers the no-login /demo (classify/draft/extract run for real, send is a no-op).
# Can be the same value as GROQ_API_KEY.
DEMO_GROQ_API_KEY=

# (Ollama is configured in the /setup UI, not here — no env vars needed.)

# ── Google OAuth (self-host only — create your own OAuth app) ──
# See the README for the 5-step setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ── App ───────────────────────────────────────────────────────
# Encrypts the session cookie. Any 32+ char random string: openssl rand -hex 32
SESSION_SECRET=

# SQLite database file (applications + timeline events + cursor).
DATABASE_URL=file:./openmail.db

# Shared secret for the daily cron endpoint (sent as the x-cron-secret header).
CRON_SECRET=
